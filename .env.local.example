# ============================================================
# GoSkate — Environment Variables
#
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and never committed.
# ============================================================

# Supabase project URL (from Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (from Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Places API key (only needed for the enrichment script)
# This is NOT used in the frontend — only in scripts/enrich-spots.ts
GOOGLE_PLACES_API_KEY=your-google-api-key-here

# Production site URL, used for Open Graph tags, robots.txt, and sitemap.xml.
# Optional — on Vercel this falls back automatically to
# VERCEL_PROJECT_PRODUCTION_URL, so this is only needed if you want to
# override that (e.g. a custom domain that differs from the Vercel one).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
